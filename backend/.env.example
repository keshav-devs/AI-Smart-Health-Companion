# ───────────────────────────────────────────────────────────────
# AI Smart Health Companion — Backend Environment Configuration
# Copy this file to .env before starting the backend service.
# Never commit real API keys or credentials.
# ───────────────────────────────────────────────────────────────

# Database (SQLite for simple local run, or PostgreSQL for Docker/production)
DATABASE_URL=sqlite+aiosqlite:///./healthapp.db

# JWT Security
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Gemini AI (Optional — leave empty for mock/offline testing)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Geoapify Places (Optional — leave empty for fallback/mock testing)
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY_HERE

